{
  // Repo-owned keys (keep): editor.* and terminal.font.
  "editor": {
    "fontSize": 13,
    "tabSize": 2
  },
  "terminal": {
    "font": "Mono Example"
  },
  // A key whose name contains dots; its key path is files\.exclude.
  "files.exclude": {
    "**/.cache": true
  },
  // Sealed for the personal enclave; the fixture generator replaces this
  // placeholder with a sealed value token.
  "sync": {
    "token": "@@SEAL:personal:sync.token@@"
  }
}
